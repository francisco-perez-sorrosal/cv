  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON Resume-compatible schema with custom extensions.\n\nCustom extensions beyond JSON Resume:\n- work[].projects: nested projects within positions\n- work[].roles: role tags per position\n- patents[]: patent section\n- conferences[]: conference attendance and reviewer roles\n- memberships[]: professional memberships\n- book_reviews[]: technical book reviewer credits\n- leadership[]: leadership & communication section\n- publications[].citations: citation count\n- publications[].authors: author list\n- All entry types have an 'id' field for semantic overlay references",
  "properties": {
    "basics": {
      "$ref": "#/$defs/PersonalInfo",
      "default": {
        "email": "",
        "label": "",
        "location": {
          "address": "",
          "city": "",
          "countryCode": "",
          "postalCode": "",
          "state": ""
        },
        "name": "",
        "phone": "",
        "profiles": [],
        "summary": "",
        "url": ""
      }
    },
    "book_reviews": {
      "default": [],
      "description": "Technical book reviewer credits",
      "items": {
        "$ref": "#/$defs/BookReview"
      },
      "title": "Book Reviews",
      "type": "array"
    },
    "certificates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Certificate"
      },
      "title": "Certificates",
      "type": "array"
    },
    "conferences": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Conference"
      },
      "title": "Conferences",
      "type": "array"
    },
    "education": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    },
    "institutions": {
      "default": [],
      "description": "Organizations referenced by work, education, certificates",
      "items": {
        "$ref": "#/$defs/Institution"
      },
      "title": "Institutions",
      "type": "array"
    },
    "interests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Interest"
      },
      "title": "Interests",
      "type": "array"
    },
    "languages": {
      "default": [],
      "items": {
