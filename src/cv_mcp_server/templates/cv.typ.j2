{% include '_preamble.typ.j2' %}

//------------- PROFILE AND GOALS --------------------------------------------
{% if resume.personal_info.summary %}
{% raw %}= Profile and Goals{% endraw %}

{{ resume.personal_info.summary | typst_escape }}
{% endif %}
//------------- PROFILE AND GOALS --------------------------------------------

//------------- PROFESSIONAL EXPERIENCE --------------------------------------------
{% if industry_work %}
{% raw %}= Professional Experience{% endraw %}

{% for w in industry_work %}
{% include '_work_entry.typ.j2' %}

{% endfor %}
{% endif %}
//------------- PROFESSIONAL EXPERIENCE --------------------------------------------

//------------- PATENTS --------------------------------------------
{% if resume.patents %}
{% raw %}= Patents{% endraw %}

{% for p in resume.patents %}
{% raw %}#cv-entry({% endraw %}
  date: [{{ p.date }}],
  title: [{{ p.number }}],
  employer: [{{ p.title | typst_escape }}],
  description: [{{ "App" if p.status.value == "application" else "Pat" }}],
)
{% endfor %}
{% endif %}
//------------- PATENTS --------------------------------------------

//------------- ACADEMIC RESEARCH EXPERIENCE --------------------------------------------
{% if academic_work %}
{% raw %}= Academic Research Experience{% endraw %}

{% for w in academic_work %}
{% include '_work_entry.typ.j2' %}

{% endfor %}
{% if academic_publications %}
{% raw %}#cv-entry({% endraw %}
  title: [Publications in Top Conferences and Journals],
)
{% for p in academic_publications %}
{% set cite_mark = " *" ~ (p.citations | string) ~ " Citations*" if p.citations else "" %}
- _{{ p.name | typst_escape }}_. In {{ p.publisher | typst_escape }}{{ cite_mark }}
{% endfor %}

{% endif %}
{% endif %}
//------------- ACADEMIC RESEARCH EXPERIENCE --------------------------------------------

//------------- SKILLS --------------------------------------------
{% if resume.skills %}
{% raw %}= Skills{% endraw %}

{% for sg in resume.skills %}
{% raw %}== {% endraw %}{{ sg.name | typst_escape }}

{% for skill in sg.skills %}
{% set level = skill_levels.get(skill.name | lower, "") if skill_levels else "" %}
{% set level_tag = " [" ~ level ~ "]" if level else "" %}
{% raw %}#cv-entry({% endraw %}
  title: [{{ skill.name }}{{ level_tag }}],
  description: [{{ skill.keywords | join(", ") | typst_escape }}.],
)
{% endfor %}
{% endfor %}
{% endif %}
//------------- SKILLS --------------------------------------------

//------------- COURSES --------------------------------------------
{% if resume.certificates %}
{% raw %}= Courses{% endraw %}

{% for c in resume.certificates %}
{% set inst = c.institution_id | inst_name %}
{% set loc_or_format = c.format if c.format else "" %}
{% set loc = c.location if c.location else "" %}
{% raw %}#cv-entry({% endraw %}
  date: [{{ c.date }}],
  title: [{{ c.name | typst_escape }}],
  employer: [{{ inst | typst_escape }}],
{% if loc_or_format %}
  location: [{{ loc_or_format }}],
{% endif %}
{% if c.url %}
  description: [#link("{{ c.url }}")[Certificate]],
{% endif %}
)
{% endfor %}
{% endif %}
//------------- COURSES --------------------------------------------

//------------- EDUCATION --------------------------------------------
{% if resume.education %}
{% raw %}= Education{% endraw %}

{% for e in resume.education %}
{% set inst = e.institution_id | inst_name %}
{% set period = e | typst_period %}
{% set dept_inst = (e.department ~ " at " if e.department else "") ~ (inst | typst_escape) %}
{% set loc = e.location if e.location else "" %}
{% set degree = e.study_type | typst_escape %}
{% if e.area and e.area not in e.study_type %}
{% set degree = degree ~ " in " ~ e.area %}
{% endif %}
{% raw %}#cv-entry({% endraw %}
  date: [{{ period }}],
  title: [{{ degree }}],
  employer: [{{ dept_inst }}],
{% if loc %}
  location: [{{ loc }}],
{% endif %}
)
{% endfor %}
{% endif %}
//------------- EDUCATION --------------------------------------------

//------------- LEADERSHIP AND COMMUNICATION SKILLS --------------------------------------------
{% if resume.leadership %}
{% raw %}= Leadership & Communication{% endraw %}

{% for cat in resume.leadership %}
{% raw %}== {% endraw %}{{ cat.name | typst_escape }}

{% for item in cat.items %}
{% raw %}#cv-entry({% endraw %}
  title: [{{ item.label | typst_escape }}],
  description: [{{ item.description | typst_escape }}],
)
{% endfor %}
{% endfor %}
{% endif %}
//------------- LEADERSHIP AND COMMUNICATION SKILLS --------------------------------------------

//------------- LANGUAGES --------------------------------------------
{% if resume.languages %}
{% raw %}= Languages{% endraw %}

{% for lang in resume.languages %}
{% set fluency = lang.fluency | replace("native", "Mother tongue") | replace("professional", "Professional proficiency") | replace("intermediate", "Intermediate proficiency") | replace("fluent", "Fluent proficiency") %}
{% raw %}#cv-entry({% endraw %}
  title: [{{ lang.language }}],
  description: [_{{ fluency }}_],
)
{% endfor %}
{% endif %}
//------------- LANGUAGES --------------------------------------------

//------------- OTHER ACTIVITIES RELATED TO CS --------------------------------------------
{% if resume.projects or resume.memberships or resume.conferences %}
{% raw %}= Other Activities Related to Computer Science{% endraw %}

{% if resume.projects %}
{% raw %}== {% endraw %}Open Source Project Maintainer

{% for p in resume.projects %}
{% if p.url %}
- _{{ p.name | typst_escape }}_: {{ p.description | typst_escape }} #link("{{ p.url }}")[Info]
{% else %}
- _{{ p.name | typst_escape }}_: {{ p.description | typst_escape }}
{% endif %}
{% endfor %}
{% endif %}
{% if committers %}
{% raw %}== {% endraw %}Committer in the Apache Software Foundation

{% for m in committers %}
- _Apache Omid project, a high-performant and scalable Transaction Manager for HBase_
{% endfor %}
{% endif %}
{% if reviewer_groups %}
{% raw %}== {% endraw %}Reviewer in International Academic Conferences

{% for r in reviewer_groups %}
- _{{ r.name | typst_escape }}_, {{ r.years }}
{% endfor %}
{% endif %}
{% if conference_list %}
{% raw %}== {% endraw %}Speaker/Attendee in Academic/Technical Conferences

{% for c in conference_list %}
{% set speaker_mark = " (Speaker)" if c.role == "speaker" else "" %}
{% set location_mark = ", " ~ (c.location | typst_escape) if c.location else "" %}
- _{{ c.name | typst_escape }}{{ speaker_mark }}_, {{ c.date }}{{ location_mark }}
{% endfor %}
{% endif %}
{% if members %}
{% raw %}== {% endraw %}Member

{% for m in members %}
{% if m.url %}
- _{{ m.organization | typst_escape }}_, #link("{{ m.url }}")[{{ m.url }}]
{% else %}
- _{{ m.organization | typst_escape }}_
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
//------------- OTHER ACTIVITIES RELATED TO CS --------------------------------------------

//------------- HOBBIES AND INTERESTS --------------------------------------------
{% if resume.interests %}
{% raw %}= Hobbies and Interests{% endraw %}

{% for i in resume.interests %}
{{ i.description | typst_escape }}

{% endfor %}
{% endif %}
//------------- HOBBIES AND INTERESTS --------------------------------------------
