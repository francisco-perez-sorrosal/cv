\documentclass[11pt,a4paper,english, sans]{moderncv}      % a4paper, a5paper, b5paper, letterpaper, legalpaper, executivepaper, landscape
                                                          % 10pt, 11pt, 12pt, english, sans

% moderncv setup
\moderncvcolor{blue} % optional argument are 'blue' (default), 'orange', 'red', 'green', 'grey' and 'roman' (for roman fonts, instead of sans serif fonts)
\moderncvstyle{classic} % casual (default), classic, banking, oldstyle, fancy

% adjust the page margins
\usepackage[scale=0.8]{geometry}

% Font encoding and family
% \usepackage[utf8]{inputenc}                   % character encoding: replace by the encoding you are using
