{% include '_preamble.tex.j2' %}

%------------- TAILORING: HIGHLIGHT COMMAND ------------------------------------
% Custom command for keyword emphasis in tailored CVs
{% raw %}
\newcommand{\highlight}[1]{\textbf{#1}}
{% endraw %}
%------------- TAILORING: HIGHLIGHT COMMAND ------------------------------------

%------------- BEGIN DOCUMENT --------------------------------------------------

\begin{document}

\maketitle
\vspace{-0.5cm}

%------------- DYNAMIC SECTIONS (ordered by TailoringSpec) --------------------
{% for section_name in included_sections %}

%------------- {{ section_name | upper }} --------------------------------------
{% if section_name == "Profile and Goals" %}
{% if tailoring.profile_override %}
\section{Profile and Goals}

\small {{ tailoring.profile_override | latex_escape }}
{% elif resume.personal_info.summary %}
\section{Profile and Goals}

\small {{ resume.personal_info.summary | latex_escape }}
{% endif %}

{% elif section_name == "Professional Experience" %}
{% if industry_work %}
\section{Professional Experience}

{% for w in industry_work %}
{% include '_work_entry.tex.j2' %}

{% endfor %}
{% endif %}

{% elif section_name == "Patents" %}
{% if resume.patents %}
\section{Patents}

{% for p in resume.patents %}
\cventry{{ "{" }}{{ p.date }}{{ "}" }}{{ "{" }}{{ p.number }}{{ "}" }}{{ "{" }}{{ p.title | latex_escape }}{{ "}" }}{{ "{" }}{{ "App" if p.status.value == "application" else "Pat" }}{{ "}" }}{}{}
{% endfor %}
{% endif %}

{% elif section_name == "Academic Research Experience" %}
{% if academic_work %}
\section{Academic Research Experience}

{% for w in academic_work %}
{% include '_work_entry.tex.j2' %}

{% endfor %}
{% if academic_publications %}
\cventry{}{Publications in Top Conferences and Journals}{}{}{}{
\begin{itemize}[leftmargin=*,noitemsep,topsep=0pt,parsep=3pt,partopsep=0pt]
{% for p in academic_publications %}
{% set cite_mark = " \\textbf{" ~ p.citations ~ " Citations}" if p.citations else "" %}
\item \textit{{ "{" }}{{ p.name | latex_escape }}{{ "}" }}. In {{ p.publisher | latex_escape }}{{ cite_mark }}
{% endfor %}
\end{itemize}
}
{% endif %}
{% endif %}

{% elif section_name == "Skills" %}
{% if resume.skills %}
\section{Skills}

{% for sg in resume.skills %}
\subsection{{ "{" }}{{ sg.name | latex_escape }}{{ "}" }}
{% for skill in sg.skills %}
\cvitem{{ "{" }}{{ skill.name }}{{ "}" }}{{ "{" }}{{ skill.keywords | join(", ") | latex_escape }}.{{ "}" }}
{% endfor %}

{% endfor %}
{% endif %}

{% elif section_name == "Courses" %}
{% if resume.certificates %}
\section{Courses}

{% for c in resume.certificates %}
{% set inst = c.institution_id | inst_name %}
{% set cert_link = "\\href{" ~ c.url ~ "}{Certificate}" if c.url else "" %}
{% set loc_or_format = c.format if c.format else "" %}
{% set loc = c.location if c.location else "" %}
\cventry{{ "{" }}{{ c.date }}{{ "}" }}{{ "{" }}{{ c.name | latex_escape }}{{ "}" }}{{ "{" }}{{ inst | latex_escape }}{{ "}" }}{{ "{" }}{{ loc_or_format }}{{ "}" }}{{ "{" }}{% if loc and cert_link %}{{ loc }}{{ "}" }}{{ "{" }}{{ cert_link }}{% elif loc %}{{ loc }}{% elif cert_link %}{{ cert_link }}{% endif %}{{ "}" }}{}
{% endfor %}
{% endif %}

{% elif section_name == "Education" %}
{% if resume.education %}
\section{Education}

{% for e in resume.education %}
{% set inst = e.institution_id | inst_name %}
{% set period = e | latex_period %}
{% set dept_inst = (e.department ~ " at " if e.department else "") ~ (inst | latex_escape) %}
{% set loc = e.location if e.location else "" %}
{% set degree = e.study_type | latex_escape %}
{% if e.area and e.area not in e.study_type %}
{% set degree = degree ~ " in " ~ e.area %}
{% endif %}
\cventry{{ "{" }}{{ period }}{{ "}" }}{{ "{" }}{{ degree }}{{ "}" }}{{ "{" }}{{ dept_inst }}{{ "}" }}{{ "{" }}{{ loc }}{{ "}" }}{}{}
{% endfor %}
{% endif %}

{% elif section_name == "Leadership and Communication" %}
{% if resume.leadership %}
\section{Leadership \& Communication}

{% for cat in resume.leadership %}
\subsection{{ "{" }}{{ cat.name | latex_escape }}{{ "}" }}
{% for item in cat.items %}
\cvitem{{ "{" }}{{ item.label | latex_escape }}{{ "}" }}{{ "{" }}{{ item.description | latex_escape }}{{ "}" }}
{% endfor %}

{% endfor %}
{% endif %}

{% elif section_name == "Languages" %}
{% if resume.languages %}
\section{Languages}

{% set lang_pairs = [] %}
{% for i in range(0, resume.languages | length, 2) %}
{% set l1 = resume.languages[i] %}
{% set l2 = resume.languages[i + 1] if i + 1 < resume.languages | length else none %}
{% if l2 %}
{% set fluency1 = l1.fluency | replace("native", "Mother tongue") | replace("professional", "Professional proficiency") | replace("intermediate", "Intermediate proficiency") | replace("fluent", "Fluent proficiency") %}
{% set fluency2 = l2.fluency | replace("native", "Mother tongue") | replace("professional", "Professional proficiency") | replace("intermediate", "Intermediate proficiency") | replace("fluent", "Fluent proficiency") %}
\cvcomputer{{ "{" }}{{ l1.language }}{{ "}" }}{{ "{" }}\textit{{ "{" }}{{ fluency1 }}{{ "}" }}{{ "}" }}{{ "{" }}{{ l2.language }}{{ "}" }}{{ "{" }}\textit{{ "{" }}{{ fluency2 }}{{ "}" }}{{ "}" }}
{% else %}
\cvcomputer{{ "{" }}{{ l1.language }}{{ "}" }}{{ "{" }}\textit{{ "{" }}{{ l1.fluency }}{{ "}" }}{{ "}" }}{}{}
{% endif %}
{% endfor %}
{% endif %}

{% elif section_name == "Other Activities" %}
{% if resume.projects or resume.memberships or resume.conferences %}
\section{Other Activities Related to Computer Science}
{% if resume.projects %}
\cventry{}{Open Source Project Maintainer}{}{}{}{
\begin{itemize}[leftmargin=*,noitemsep,topsep=0pt,parsep=3pt,partopsep=0pt]
{% for p in resume.projects %}
{% set url_mark = " \\href{" ~ p.url ~ "}{Crates Info}" if p.url else "" %}
\item \textit{{ "{" }}{{ p.name | latex_escape }}{{ "}" }}: {{ p.description | latex_escape }}{{ url_mark }}
{% endfor %}
\end{itemize}
}
{% endif %}
{% if committers %}
\cventry{}{Committer in the Apache Software Foundation}{}{}{}{
\begin{itemize}[leftmargin=*,noitemsep,topsep=0pt,parsep=3pt,partopsep=0pt]
{% for m in committers %}
\item \textit{Apache Omid project, a high-performant and scalable Transaction Manager for HBase}
{% endfor %}
\end{itemize}
}
{% endif %}
{% if reviewer_groups %}
\cventry{}{Reviewer in International Academic Conferences}{}{}{}{
\begin{itemize}[leftmargin=*,noitemsep,topsep=0pt,parsep=3pt,partopsep=0pt]
{% for r in reviewer_groups %}
\item \textit{{ "{" }}{{ r.name | latex_escape }}{{ "}" }}, {{ r.years }}
{% endfor %}
\end{itemize}
}
{% endif %}
{% if conference_list %}
\cventry{}{Speaker/Attendee in Academic/Technical Conferences}{}{}{}{
\begin{itemize}[leftmargin=*,noitemsep,topsep=0pt,parsep=3pt,partopsep=0pt]
{% for c in conference_list %}
{% set speaker_mark = " (Speaker)" if c.role == "speaker" else "" %}
{% set location_mark = ", " ~ (c.location | latex_escape) if c.location else "" %}
\item \textit{{ "{" }}{{ c.name | latex_escape }}{{ speaker_mark }}{{ "}" }}, {{ c.date }}{{ location_mark }}
{% endfor %}
\end{itemize}
}
{% endif %}
{% if members %}
\cventry{}{Member}{}{}{}{
\begin{itemize}[leftmargin=*,noitemsep,topsep=0pt,parsep=3pt,partopsep=0pt]
{% for m in members %}
{% set url_mark = ", \\href{" ~ m.url ~ "}{" ~ m.url ~ "}" if m.url else "" %}
\item \textit{{ "{" }}{{ m.organization | latex_escape }}{{ "}" }}{{ url_mark }}
{% endfor %}
\end{itemize}
}
{% endif %}
{% endif %}

{% elif section_name == "Hobbies and Interests" %}
{% if resume.interests %}
\section{Hobbies and Interests}
{% for i in resume.interests %}
\cvline{}{{ "{" }}{{ i.description | latex_escape }}
{{ "}" }}
{% endfor %}
{% endif %}

{% endif %}
{% endfor %}
%------------- END DYNAMIC SECTIONS -------------------------------------------

\end{document}
